FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      alpha.Water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;

boundaryField
{
    inlet
    {
        type            timeVaryingMappedFixedValue;
        fieldTable      alpha.Water;
        mapMethod       nearest;
        value           uniform 1;
    }
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    walls
    {
        type            contactAngle;
        theta0          25;
        limit           gradient;
        value           uniform 0;
    }
}


// ************************************************************************* //
