FoamFile
{
    format      ascii;
    class       volScalarField;
    location    "0";
    object      nut;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 2 -1 0 0 0 0];

internalField   uniform 0;

boundaryField
{

    outlet
    {
        type        calculated;
        value       $internalField;
    }

    inlet
    {
        type        calculated;
        value       $internalField;
    }

    wall
    {
        type        nutkWallFunction;
        value       uniform 0;
    }

    defaultFaces
    {
        type        zeroGradient;
    }

}

