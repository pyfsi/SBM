FoamFile
{
    version     2.0;
    format      ascii;
    arch        "LSB;label=32;scalar=64";
    class       volScalarField;
    location    "0";
    object      alpha.water;
}
// * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * * //

dimensions      [0 0 0 0 0 0 0];

internalField   uniform 1;


boundaryField
{
    outlet
    {
        type            inletOutlet;
        inletValue      uniform 0;
        value           uniform 0;
    }
    inlet
    {
        type            timeVaryingMappedFixedValue;
        fieldTable      alpha.water
        offset          constant 0;
        value           uniform 1;
	mapMethod	nearest;
    }
    cylinder
    {
        //type          zeroGradient;
	type		constantAlphaContactAngle;
	theta0		45;
	limit		gradient;
	value		uniform 0;
    }
    defaultFaces
    {
        type            constantAlphaContactAngle;
        theta0          25;
        limit           gradient;
        value           uniform 0;
    }
}


// ************************************************************************* //
